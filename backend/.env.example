# Copy to .env (never commit). Production requires DEBUG=0 and a long random SECRET_KEY.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=yourapp.example.com
CSRF_TRUSTED_ORIGINS=https://yourapp.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=1
SSL_REDIRECT=1
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BantayBarangay <no-reply@example.com>
MEDIA_ROOT=/data/media
